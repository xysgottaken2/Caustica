#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(location = 0) rayPayloadEXT vec3 radiance;
layout(push_constant, std430) uniform Camera {
    mat4 inverseViewProjection;
    vec4 origin;
    uvec4 frame; // width, height, test triangle, reserved
} camera;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    // Minecraft projection matrices use Vulkan Y/depth conventions; no OpenGL Y flip.
    vec3 rayOrigin = camera.origin.xyz;
    vec4 projected = camera.inverseViewProjection * vec4(ndc, 0.5, 1.0);
    vec3 direction = normalize(projected.xyz / projected.w - rayOrigin);
    if (camera.frame.z == 1u) {
        // Fixed diagnostic camera: an actual primary ray hits or misses the test BLAS.
        rayOrigin = vec3(0, 0, 2);
        direction = normalize(vec3(ndc.x * float(camera.frame.x) / float(camera.frame.y), -ndc.y, -1.5));
    }
    radiance = vec3(0);
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, rayOrigin, 0.001, direction, 4096.0, 0);
    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(radiance, 1));
}
