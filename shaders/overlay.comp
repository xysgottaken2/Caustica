#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x=64) in;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Words { uint data[]; };
layout(push_constant,std430) uniform Params {
    uvec2 solid; uvec2 cutout; uvec2 matches; uvec2 heads; uvec2 links;
    uint solidStride; uint solidPos; uint solidQuads;
    uint cutoutStride; uint cutoutPos; uint cutoutQuads; uint mask; uint pass;
} p;
vec3 pos(Words v,uint index,uint stride,uint offset) {
    uint i=index*stride+offset;
    return vec3(uintBitsToFloat(v.data[i]),uintBitsToFloat(v.data[i+1u]),uintBitsToFloat(v.data[i+2u]));
}
uint hashCenter(vec3 center) {
    ivec3 cell=ivec3(round(center*4096.0));
    uint h=uint(cell.x)*73856093u ^ uint(cell.y)*19349663u ^ uint(cell.z)*83492791u;
    h^=h>>16; h*=0x7feb352du; h^=h>>15; h*=0x846ca68bu; h^=h>>16;
    return h&p.mask;
}
void main() {
    uint q=gl_GlobalInvocationID.x;
    Words heads=Words(p.heads),links=Words(p.links);
    if(p.pass==0u) {
        if(q>=p.cutoutQuads) return;
        Words v=Words(p.cutout); uint b=q*4u;
        vec3 c=(pos(v,b,p.cutoutStride,p.cutoutPos)+pos(v,b+1u,p.cutoutStride,p.cutoutPos)
              +pos(v,b+2u,p.cutoutStride,p.cutoutPos)+pos(v,b+3u,p.cutoutStride,p.cutoutPos))*0.25;
        uint bucket=hashCenter(c);
        links.data[q]=atomicExchange(heads.data[bucket],q);
        return;
    }
    if(q>=p.solidQuads) return;
    Words outMap=Words(p.matches),s=Words(p.solid),c=Words(p.cutout);
    vec3 a[4]; vec3 center=vec3(0);
    for(uint i=0u;i<4u;i++) { a[i]=pos(s,q*4u+i,p.solidStride,p.solidPos); center+=a[i]*0.25; }
    uvec4 best=uvec4(0xffffffffu); uint bestQuad=0u; bool found=false;
    vec3 normal=cross(a[1]-a[0],a[2]-a[0]);
    uint link=heads.data[hashCenter(center)]; uint visited=0u;
    // Hard bound for pathological custom models/hash collisions. Sentinel reports truncated lookup.
    while(link!=0xffffffffu && visited++<1024u) {
        if(link>=p.cutoutQuads) break;
        vec3 b[4];
        for(uint j=0u;j<4u;j++) b[j]=pos(c,link*4u+j,p.cutoutStride,p.cutoutPos);
        uvec4 permutation=uvec4(0xffffffffu); uint used=0u;
        for(uint i=0u;i<4u;i++) for(uint j=0u;j<4u;j++) {
            if((used&(1u<<j))==0u && all(lessThan(abs(a[i]-b[j]),vec3(0.00001)))) {
                permutation[i]=link*4u+j; used|=1u<<j; break;
            }
        }
        // Opposite-facing adjacent block faces must never become a material overlay.
        if(used==15u && dot(normal,cross(b[1]-b[0],b[2]-b[0]))>0.0 && (!found || link>bestQuad)) {
            found=true; best=permutation; bestQuad=link;
        }
        link=links.data[link];
    }
    if(link!=0xffffffffu && visited>=1024u) best=uvec4(0xfffffffeu);
    for(uint i=0u;i<4u;i++) outMap.data[q*4u+i]=best[i];
}
