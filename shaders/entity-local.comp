#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x=64) in;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Vertices { uint words[]; };
layout(push_constant,std430) uniform Local { uvec2 address; uint stride; uint count; mat4 inversePose; } pc;
void main() {
 uint i=gl_GlobalInvocationID.x;if(i>=pc.count) return;
 Vertices v=Vertices(pc.address);uint w=i*pc.stride;
 vec3 p=vec3(uintBitsToFloat(v.words[w]),uintBitsToFloat(v.words[w+1u]),uintBitsToFloat(v.words[w+2u]));
 vec3 local=(pc.inversePose*vec4(p,1)).xyz;
 v.words[w]=floatBitsToUint(local.x);v.words[w+1u]=floatBitsToUint(local.y);v.words[w+2u]=floatBitsToUint(local.z);
 // All non-position bytes are retained. UV/Color are not inferred or retessellated.
}
