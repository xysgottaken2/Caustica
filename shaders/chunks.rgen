    vec2 uv=probePass ? vec2(0.5) : (vec2(gl_LaunchIDEXT.xy)+0.5)/vec2(gl_LaunchSizeEXT.xy);
    vec4 projected=camera.inverseViewProjection*vec4(uv*2.0-1.0,0.5,1.0);
    vec3 direction=normalize(projected.xyz/projected.w-camera.origin.xyz);
    hit.color=vec3(0); hit.found=0u; hit.section=ivec3(0); hit.primitive=0u; hit.uv=vec2(0); hit.sampled=0u; hit.atlasSize=ivec2(0); hit.quadSpan=vec2(0); hit.mode=0u; hit.levels=0; hit.baseTint=vec4(0); hit.overlayTint=vec4(0); hit.sampleColor=vec4(0); hit.baseUv=vec2(0); hit.overlayState=0u; hit.face=0u; hit.layer=0u; hit.alphaStats=uvec4(0u,0u,floatBitsToUint(1.0),floatBitsToUint(0.0)); hit.cutoutSample=vec4(-1); hit.cutoutSection=ivec4(0,0,0,-1);
    hit.entityRecord=0xffffffffu;
    hit.distance=4096.0;hit.alpha=1.0;hit.previous=uvec2(0xffffffffu);
    hit.transStats=uvec4(0u,0u,floatBitsToUint(1.0),floatBitsToUint(0.0));hit.transSample=vec4(-1);hit.transSection=ivec4(0,0,0,-1);
    traceRayEXT(scene,gl_RayFlagsNoneEXT,0xff,0,0,0,camera.origin.xyz,0.001,direction,4096.0,0);
    if(probePass) {
        probe.entity=uvec4(hit.entityRecord,hit.sampled,hit.layer,hit.primitive);
        probe.state=uvec4(hit.found,hit.primitive,hit.sampled,hit.layer);
        probe.alphaStats=hit.alphaStats; probe.cutoutSample=hit.cutoutSample; probe.cutoutSection=hit.cutoutSection;
        probe.section=ivec4(hit.section,0); probe.uv=vec4(hit.uv,hit.quadSpan); probe.color=vec4(hit.color,1);
        probe.atlas=uvec4(hit.atlasSize,uint(hit.levels),hit.mode);
        probe.baseTint=hit.baseTint; probe.overlayTint=hit.overlayTint; probe.sampleColor=hit.sampleColor;
        probe.tintInfo=vec4(hit.baseUv,float(hit.overlayState),float(hit.face));
    }
    // Ordered closest-hit continuation, never unordered any-hit blending or recursive trace calls.
    vec3 composed=vec3(0);float remaining=1.0,nextT=0.001,firstAlpha=-1.0;
    uint layers=0u,overflow=0u,terminal=0u,firstAction=0u;
    for(uint step=0u;step<64u;step++) {
        if(probePass && probe.entity.x==0xffffffffu && hit.entityRecord!=0xffffffffu)
            probe.entity=uvec4(hit.entityRecord,hit.sampled,hit.layer,hit.primitive);
        if(hit.found==0u || hit.layer!=2u) {
            composed+=remaining*hit.color;terminal=hit.found;break;
        }
        if(probePass && layers==0u) {
            probe.transSample=vec4(hit.uv,hit.sampleColor.a,hit.baseTint.a);
            probe.transSection=ivec4(hit.section,int(hit.primitive));firstAlpha=hit.alpha;
        }
        composed+=remaining*hit.alpha*hit.color;
        remaining*=1.0-hit.alpha; layers++;
        if(remaining==0.0) { terminal=2u;if(layers==1u) firstAction=4u;break; }
        // Same origin/direction and absolute t throughout: one positive-float ULP, NOT a world-space
        // epsilon that skips thin panes. The previous triangle is additionally rejected in any-hit.
        nextT=uintBitsToFloat(floatBitsToUint(hit.distance)+1u);
        if(nextT>=4096.0) { composed+=remaining*vec3(0.018,0.025,0.045);terminal=3u;if(layers==1u) firstAction=5u;break; }
        if(step==63u) {
            // With vanilla alpha>=.1, residual weight is <=.9^64 (~.00118). Bound work and retain
            // the opaque/CUTOUT background rather than making overflow a black/opaque surface.
            overflow=1u;
            traceRayEXT(scene,gl_RayFlagsNoneEXT,0x01,0,0,0,camera.origin.xyz,nextT,direction,4096.0,0);
            composed+=remaining*hit.color;terminal=hit.found;break;
        }
        traceRayEXT(scene,gl_RayFlagsNoneEXT,0xff,0,0,0,camera.origin.xyz,nextT,direction,4096.0,0);
        if(layers==1u) firstAction=3u; // actual continuation returned, not inferred from alpha alone
    }
    if(probePass) {
        probe.color=vec4(composed,1);
        probe.alphaStats=hit.alphaStats;probe.cutoutSample=hit.cutoutSample;probe.cutoutSection=hit.cutoutSection;
        probe.transStats=hit.transStats;
        if(layers==0u) { probe.transSample=hit.transSample;probe.transSection=hit.transSection; }
        probe.transState=uvec4(layers,overflow,layers>0u?1u:0u,terminal);
        probe.transBlend=vec4(firstAlpha,remaining,nextT,float(firstAction));
    } else imageStore(outputImage,pixel,vec4(composed,1));
}
