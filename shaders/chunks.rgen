#version 460
#extension GL_EXT_ray_tracing : require
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,rgba8) uniform image2D outputImage;
struct Hit { vec3 color; uint found; ivec3 section; uint primitive; vec2 uv; uint sampled; };
layout(location=0) rayPayloadEXT Hit hit;
layout(set=0,binding=4,std430) buffer Probe { uvec4 state; ivec4 section; vec4 uv; vec4 color; } probe;
layout(push_constant,std430) uniform Camera { mat4 inverseViewProjection; vec4 origin; uvec4 frame; } camera;
// GPU-only center-ray telemetry. One optional 1x1 trace writes this probe, then a barrier precedes
// the image trace/HUD. No vertex, image, UV or hit-record data is ever mapped/read by the CPU.
uint glyph(int c) {
 switch(c) {
 case 48: return 31599u;
 case 49: return 29850u;
 case 50: return 29347u;
 case 51: return 14499u;
 case 52: return 18925u;
 case 53: return 14543u;
 case 54: return 31694u;
 case 55: return 9383u;
 case 56: return 31727u;
 case 57: return 14831u;
 case 65: return 23530u;
 case 66: return 15083u;
 case 67: return 25166u;
 case 68: return 15211u;
 case 69: return 29391u;
 case 70: return 4815u;
 case 71: return 27470u;
 case 72: return 23533u;
 case 73: return 29847u;
 case 74: return 11044u;
 case 75: return 23277u;
 case 76: return 29257u;
 case 77: return 23549u;
 case 78: return 24573u;
 case 79: return 11114u;
 case 80: return 4843u;
 case 81: return 28522u;
 case 82: return 23275u;
 case 83: return 14478u;
 case 84: return 9367u;
 case 85: return 31597u;
 case 86: return 11117u;
 case 87: return 24557u;
 case 88: return 23213u;
 case 89: return 9389u;
 case 90: return 29351u;
 case 61: return 3640u;
 case 45: return 448u;
 case 43: return 1488u;
 case 46: return 8192u;
 case 44: return 5120u;
 default: return 0u;
 }
}
const int label0[7]=int[](82,84,32,72,73,84,61);
const int label1[8]=int[](83,69,67,84,73,79,78,61);
const int label2[10]=int[](80,82,73,77,73,84,73,86,69,61);
const int label3[3]=int[](85,86,61);
const int label4[18]=int[](65,84,76,65,83,61,66,76,79,67,75,83,32,76,79,68,61,48);
const int label5[16]=int[](84,69,88,84,85,82,69,32,83,65,77,80,76,69,68,61);
int digit(uint v,int n,int count) {
    uint divisor=1u; for(int i=0;i<count-1-n;i++) divisor*=10u;
    return 48+int((v/divisor)%10u);
}
int yesNo(bool yes,int n) {
    if(yes) return n==0?89:n==1?69:n==2?83:32;
    return n==0?78:n==1?79:32;
}
int text(int row,int col) {
 if(row==0 && col<7) return label0[col];
 if(row==1 && col<8) return label1[col];
 if(row==2 && col<10) return label2[col];
 if(row==3 && col<3) return label3[col];
 if(row==4 && col<18) return label4[col];
 if(row==5 && col<16) return label5[col];
 if(row==0) return yesNo(probe.state.x!=0u,col-7);
 if(row==5) return yesNo(probe.state.z!=0u,col-16);
 if(probe.state.x==0u && (row==1 || row==2 || row==3)) return 32;
 if(row==1) {
    int c=col-8; if(c<0 || c>=26) return 32;
    int axis=c/9, part=c%9;
    if(part==8) return axis<2?44:32;
    int value=probe.section[axis];
    if(part==0) return value<0?45:43;
    return digit(uint(abs(value)),part-1,7);
 }
 if(row==2 && col>=10 && col<19) return digit(probe.state.y,col-10,9);
 if(row==3) {
    int c=col-3; if(c<0 || c>=13) return 32;
    if(c==6) return 44;
    int axis=c<6?0:1, part=c<6?c:c-7;
    float uv=clamp(probe.uv[axis],0.0,1.0);
    if(part==0) return 48+int(uv);
    if(part==1) return 46;
    return digit(uint(fract(uv)*10000.0),part-2,4);
 }
 return 32;
}
void main() {
    bool probePass=(camera.frame.w&1u)!=0u;
    ivec2 pixel=ivec2(gl_LaunchIDEXT.xy);
    if(!probePass && (camera.frame.w&2u)!=0u) {
        ivec2 panel=pixel-ivec2(8,8);
        if(all(greaterThanEqual(panel,ivec2(0))) && all(lessThan(panel,ivec2(320,84)))) {
            ivec2 p=panel/2;
            int row=p.y/7, col=p.x/4;
            bool ink=(p.x%4<3 && p.y%7<5) && ((glyph(text(row,col))>>uint((p.y%7)*3+p.x%4))&1u)!=0u;
            vec3 color=ink?vec3(0.8,1.0,0.85):vec3(0.015);
            if(panel.x>=280 && panel.y<32) color=probe.color.rgb;
            imageStore(outputImage,pixel,vec4(color,1)); return;
        }
    }
    vec2 uv=probePass ? vec2(0.5) : (vec2(gl_LaunchIDEXT.xy)+0.5)/vec2(gl_LaunchSizeEXT.xy);
    vec4 projected=camera.inverseViewProjection*vec4(uv*2.0-1.0,0.5,1.0);
    vec3 direction=normalize(projected.xyz/projected.w-camera.origin.xyz);
    hit.color=vec3(0); hit.found=0u; hit.section=ivec3(0); hit.primitive=0u; hit.uv=vec2(0); hit.sampled=0u;
    traceRayEXT(scene,gl_RayFlagsOpaqueEXT,0xff,0,0,0,camera.origin.xyz,0.001,direction,4096.0,0);
    if(probePass) {
        probe.state=uvec4(hit.found,hit.primitive,hit.sampled,0);
        probe.section=ivec4(hit.section,0); probe.uv=vec4(hit.uv,0,0); probe.color=vec4(hit.color,1);
    } else imageStore(outputImage,pixel,vec4(hit.color,1));
}
