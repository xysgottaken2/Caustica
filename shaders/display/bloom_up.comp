#version 460

// Bloom pass 3/3: mip-chain upsample.
//
// Walks the chain back up, adding each blurred low-resolution mip into the next higher one with a 3x3
// tent filter (the COD/Unity progressive upsample). Summing every scale is what gives bloom its wide,
// smooth falloff without a single huge-radius blur, and the overlap between levels removes the
// ringing a plain bilinear upscale leaves behind.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform image2D dstImage;          // mip N, accumulated in place
layout(binding = 1, set = 0, rgba16f) uniform readonly image2D srcImage; // mip N+1

layout(push_constant) uniform Push {
    float filterRadius; // tent radius, in source texels
    float blend;        // contribution of this level
} pc;

// Bilinear fetch from the source mip; `uv` is continuous source-texel space (centres at +0.5).
vec3 sampleSrc(vec2 uv, ivec2 maxCoord) {
    vec2 f = uv - vec2(0.5);
    ivec2 i0 = ivec2(floor(f));
    vec2 t = f - vec2(i0);
    vec3 s00 = imageLoad(srcImage, clamp(i0, ivec2(0), maxCoord)).rgb;
    vec3 s10 = imageLoad(srcImage, clamp(i0 + ivec2(1, 0), ivec2(0), maxCoord)).rgb;
    vec3 s01 = imageLoad(srcImage, clamp(i0 + ivec2(0, 1), ivec2(0), maxCoord)).rgb;
    vec3 s11 = imageLoad(srcImage, clamp(i0 + ivec2(1, 1), ivec2(0), maxCoord)).rgb;
    return mix(mix(s00, s10, t.x), mix(s01, s11, t.x), t.y);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);
    if (pix.x >= dstSize.x || pix.y >= dstSize.y) {
        return;
    }
    ivec2 maxCoord = imageSize(srcImage) - ivec2(1);
    vec2 uv = (vec2(pix) + vec2(0.5)) * 0.5; // this texel's centre in source-mip texel space
    float r = max(pc.filterRadius, 0.0);

    vec3 sum = sampleSrc(uv + vec2(-r, -r), maxCoord) * 1.0
            + sampleSrc(uv + vec2(0.0, -r), maxCoord) * 2.0
            + sampleSrc(uv + vec2(r, -r), maxCoord) * 1.0
            + sampleSrc(uv + vec2(-r, 0.0), maxCoord) * 2.0
            + sampleSrc(uv, maxCoord) * 4.0
            + sampleSrc(uv + vec2(r, 0.0), maxCoord) * 2.0
            + sampleSrc(uv + vec2(-r, r), maxCoord) * 1.0
            + sampleSrc(uv + vec2(0.0, r), maxCoord) * 2.0
            + sampleSrc(uv + vec2(r, r), maxCoord) * 1.0;
    sum *= 1.0 / 16.0;

    vec3 dst = imageLoad(dstImage, pix).rgb;
    imageStore(dstImage, pix, vec4(dst + sum * pc.blend, 1.0));
}
