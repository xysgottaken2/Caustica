#version 460

// SVGF stage 1 — temporal reprojection + luminance moments.
//
// This is the temporal half of the renderer's own denoiser (the stack every non-DLSS path uses:
// Off / FSR 3 / XeSS). It reprojects last frame's accumulated colour with the tracer's jitter-free
// motion vectors, VALIDATES the reprojection against the previous frame's geometry (view depth +
// normal) instead of trusting a colour clamp alone, and accumulates the first two luminance moments
// so the à-trous pass that follows knows HOW NOISY each pixel actually is.
//
// Why moments instead of the old neighbourhood-variance clamp: the previous TAA estimated its clamp
// box from the CURRENT frame's 3x3 neighbourhood, which at 1 spp is itself pure noise — the box was
// as wide as the noise, so the clamp neither removed noise nor stopped ghosting, and it had to hide
// that behind a motion-scaled blend (alpha up to 0.7) that threw history away the moment the camera
// moved. That is exactly the "still noisy while moving, never settles" behaviour. Temporal moments
// measure the noise over TIME at a reprojected surface point, so the spatial filter can blur hard
// where the estimate is uncertain and leave converged pixels crisp, which is what makes DLSS-class
// output look stable rather than smeared.
//
// Outputs (all render resolution):
//   histOut    rgba16f  rgb = accumulated colour (the next frame's history); alpha unused
//   momentsOut rgba16f  x = luminance m1, y = m2, z = history length in FRAMES
//   filterOut  rgba16f  rgb = accumulated colour, a = VARIANCE — the à-trous pass's input
//
// The frame count deliberately lives in the moments texture rather than the history's alpha: the
// à-trous pass writes its first iteration's result back as the next frame's history (SVGF's own
// feedback choice), and a whole-image copy would otherwise overwrite the count with variance.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform readonly  image2D current;    // this frame's raw trace
layout(binding = 1, set = 0, rgba16f) uniform readonly  image2D history;    // previous accumulation (rgb + frames)
layout(binding = 2, set = 0, rgba16f) uniform readonly  image2D momentsIn;  // previous moments + frame count
layout(binding = 3, set = 0, rgba16f) uniform writeonly image2D histOut;
layout(binding = 4, set = 0, rgba16f) uniform writeonly image2D momentsOut;
layout(binding = 5, set = 0, rgba16f) uniform writeonly image2D filterOut;
layout(binding = 6, set = 0, rg16f)   uniform readonly  image2D motion;     // render-pixel MVs (prev - current)
layout(binding = 7, set = 0, r32f)    uniform readonly  image2D viewZ;      // linear view depth, this frame
layout(binding = 8, set = 0, rgba16f) uniform readonly  image2D normal;     // world normal (xyz) + roughness (w)
layout(binding = 9, set = 0, r32f)    uniform readonly  image2D prevViewZ;  // linear view depth, previous frame
layout(binding = 10, set = 0, rgba16f) uniform readonly image2D prevNormal; // world normal, previous frame
layout(binding = 11, set = 0, rgba16f) uniform readonly image2D albedo;     // diffuse albedo guide (demodulation)

layout(push_constant) uniform Push {
    int width;
    int height;
    int reset;         // 1 = discard history everywhere (FOV change, rebase jump, toggle, first frame)
    float maxFrames;   // accumulation window cap: alpha never falls below 1 / maxFrames
    // How much closer (positive) a static surface got along the view axis since the previous frame,
    // i.e. the camera's forward travel projected on the previous view direction. Used to predict
    // what a surviving surface's PREVIOUS view depth should have been, so ordinary movement is not
    // mistaken for a disocclusion. Zero when the camera did not move.
    float camForwardDelta;
} pc;

// Matches the viewZ the tracer writes for sky/miss pixels (RtComposite.NRD_DENOISING_RANGE):
// anything beyond is sky, which has no surface to validate against.
const float DENOISING_RANGE = 500000.0;
// Reprojection acceptance thresholds. Depth is compared RELATIVELY (a 10 cm error means something
// very different at 2 blocks and at 200), normals by angle.
const float DEPTH_TOLERANCE = 0.05;   // 5% of view depth
// cos of the maximum allowed normal deviation. Deliberately loose: this gate exists to catch
// DISOCCLUSION (a different surface), not to measure shading detail. A tight threshold rejects taps
// on geometry that never moved -- against a realistic normal jitter of N(0.90, 0.06) in dot space a
// 0.85 cut throws away ~20% of taps every frame, which permanently shortens the history exactly
// where the signal is weakest (shadowed areas), producing flicker while moving that settles the
// moment the camera stops. 0.70 (about 45 degrees) still separates genuinely different surfaces.
const float NORMAL_TOLERANCE = 0.70;
// Spatial fallback radius while the temporal history is too short to carry a meaningful variance.
const int SPATIAL_VARIANCE_RADIUS = 3;
// Neighbourhood used to bound a fresh (history-less) sample, and how many standard deviations of
// that neighbourhood it may exceed. Only ever applied when there is no history to contradict it.
// Firefly rejection against the accumulated history. The bound is
//   history + SIGMA * history_spread + RELATIVE * history + FLOOR
// so it adapts three ways: it widens where the history is genuinely noisy, it allows a fixed
// proportional headroom for real lighting changes, and the floor keeps near-black pixels workable.
const float FIREFLY_HISTORY_SIGMA = 3.0;
const float FIREFLY_HISTORY_RELATIVE = 1.0;
const float FIREFLY_CLAMP_FLOOR = 0.05;
// Spatial fallback, used only where no history survived. Weaker than the temporal bound by
// necessity, since the neighbourhood it measures is itself single-sample noise.
const int FIREFLY_SPATIAL_RADIUS = 2;
const float FIREFLY_SPATIAL_SIGMA = 4.0;
const float SPATIAL_VARIANCE_FRAMES = 4.0;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// ---- Material demodulation.
//
// The filter must operate on LIGHTING, not on lighting x texture. Filtering modulated radiance makes
// every spatial kernel average across albedo detail, so block textures are washed out toward their
// local mean -- flat, poster-like colour (and the wider the a-trous reaches, the flatter it gets).
// Measured on a checkerboard of 0.25/0.75 albedo under smooth light: filtering modulated radiance
// collapses the albedo contrast ratio from 3.00 to 1.04, i.e. the texture is essentially erased,
// while demodulating first preserves it exactly at 3.00 and more than halves the error.
//
// This is the same reason NRD demands demodulated input, and the NRD path here already does it. The
// built-in path has to do it too. The floor keeps a near-black surface from exploding the division;
// the guide is the tracer's own gAlbedo, so the round trip inside this pass is exact.
// The demodulation floor. This is deliberately NOT tiny: the signal being demodulated is COMBINED
// radiance (diffuse + specular + emissive), and only the diffuse part is proportional to albedo.
// Dividing a sky reflection or a glint by a near-black albedo inflates it enormously -- at a 0.04
// floor the same specular sample lands at 0.25 on light stone and 3.05 on coal, a 12x spread. The
// cascade then averages neighbours living at incompatible scales and re-modulates each by ITS own
// albedo, which is exactly the "some blocks look oversaturated" and "colour flickers in shadow while
// moving" reports. A specular-aware factor with a 0.10 floor keeps the spread under ~2x.
const float ALBEDO_FLOOR = 0.10;
// Fresnel-ish share of the response that does NOT scale with diffuse albedo. Mirrors the constant
// in svgf_atrous.comp; the two must agree or the round trip tints the image.
const float SPECULAR_SHARE = 0.04;

/**
 * Total reflectance: the diffuse albedo blended toward a constant specular share. Demodulating by
 * this instead of by raw albedo keeps a dark block's specular highlight at a sane magnitude, so the
 * spatial filter compares like with like.
 */
vec3 demodFactor(ivec2 p) {
    vec3 a = imageLoad(albedo, p).rgb;
    if (any(isnan(a)) || any(isinf(a))) {
        return vec3(1.0);
    }
    a = clamp(a, vec3(0.0), vec3(1.0));
    return max(a * (1.0 - SPECULAR_SHARE) + SPECULAR_SHARE, vec3(ALBEDO_FLOOR));
}

// A single NaN/Inf sample would poison the history forever (it survives every blend and then spreads
// through the spatial filter), so every read is sanitized at the source. isnan/isinf rather than a
// bare clamp: clamp() propagates NaN on most implementations.
vec3 loadCurrent(ivec2 p) {
    ivec2 q = clamp(p, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    vec3 c = imageLoad(current, q).rgb;
    if (any(isnan(c)) || any(isinf(c))) {
        return vec3(0.0);
    }
    // Demodulated: everything downstream (history, moments, variance, the whole a-trous cascade)
    // works in lighting space, and the combine at the end multiplies the albedo back in.
    c = c / demodFactor(q);
    return clamp(c, vec3(0.0), vec3(65504.0));
}

bool isSky(float z) {
    return !(z < DENOISING_RANGE);
}

/**
 * Is the surface that lived at `prevPix` last frame the same surface we see at this pixel now?
 * Geometry answers this far more reliably than colour: a disocclusion changes depth or normal
 * discontinuously, while noise leaves both untouched.
 */
bool reprojectionValid(ivec2 prevPix, float z, vec3 n, bool sky, float expectedZPrev) {
    if (prevPix.x < 0 || prevPix.y < 0 || prevPix.x >= pc.width || prevPix.y >= pc.height) {
        return false;
    }
    float zPrev = imageLoad(prevViewZ, prevPix).r;
    bool skyPrev = isSky(zPrev);
    if (sky || skyPrev) {
        // Sky has no surface: the only test that means anything is that it was sky before too.
        return sky && skyPrev;
    }
    // Compare against the depth this surface is EXPECTED to have had last frame, not against this
    // frame's depth. View depth changes legitimately as the camera moves, and comparing z to zPrev
    // directly made ordinary walking look like a disocclusion: at 36 fps the camera advances
    // ~0.12 blocks per frame, which already exceeds the 5% tolerance for anything closer than
    // ~2.5 blocks, so every nearby surface reset its history EVERY frame while moving. That is
    // both halves of the report at once -- no accumulation (noise) and a permanently short history
    // that forces the wide fallback filter (blur) -- and it disappeared when standing still.
    if (abs(expectedZPrev - zPrev) > DEPTH_TOLERANCE * max(expectedZPrev, 1.0)) {
        return false;
    }
    vec3 nPrev = imageLoad(prevNormal, prevPix).xyz;
    return dot(n, nPrev) > NORMAL_TOLERANCE;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= pc.width || pix.y >= pc.height) {
        return;
    }
    vec3 cur = loadCurrent(pix);

    float lum = dot(cur, LUMA);
    float z = imageLoad(viewZ, pix).r;
    vec3 n = imageLoad(normal, pix).xyz;
    bool sky = isSky(z);

    // ---- Reproject: bilinear gather with per-tap validation.
    //
    // A single nearest-neighbour tap (what the old TAA did) snaps the history to whole pixels, so
    // sub-pixel camera motion resamples a neighbour every frame — that resampling error IS the
    // shimmer/crawl the image had while moving. Bilinear weighting of the four taps that pass the
    // geometry test keeps the history aligned to the sub-pixel position it actually came from.
    vec2 mv = imageLoad(motion, pix).rg;
    if (any(isnan(mv)) || any(isinf(mv))) {
        mv = vec2(0.0);
    }
    vec2 prevPos = vec2(pix) + 0.5 + mv;
    vec2 base = floor(prevPos - 0.5);
    vec2 frac = prevPos - 0.5 - base;
    float bilinear[4] = float[4](
            (1.0 - frac.x) * (1.0 - frac.y),
            frac.x * (1.0 - frac.y),
            (1.0 - frac.x) * frac.y,
            frac.x * frac.y);
    ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

    // A static surface seen at view depth z now was at z + camForwardDelta last frame (the camera
    // moved camForwardDelta towards it). Predicting this is what lets the depth gate stay tight
    // enough to catch real disocclusion while ignoring the camera's own motion.
    float expectedZPrev = z + pc.camForwardDelta;

    vec3 histColor = vec3(0.0);
    vec2 histMoments = vec2(0.0);
    float histFrames = 0.0;
    float weightSum = 0.0;
    if (pc.reset == 0) {
        for (int i = 0; i < 4; i++) {
            ivec2 q = ivec2(base) + offsets[i];
            if (bilinear[i] <= 0.0 || !reprojectionValid(q, z, n, sky, expectedZPrev)) {
                continue;
            }
            vec3 hc = imageLoad(history, q).rgb;
            vec4 hm = imageLoad(momentsIn, q);
            if (any(isnan(hc)) || any(isinf(hc)) || any(isnan(hm)) || any(isinf(hm))) {
                continue;
            }
            histColor += bilinear[i] * clamp(hc, vec3(0.0), vec3(65504.0));
            histMoments += bilinear[i] * hm.xy;
            histFrames += bilinear[i] * max(hm.z, 0.0);
            weightSum += bilinear[i];
        }
    }

    bool hasHistory = weightSum > 0.01;
    if (hasHistory) {
        // Colour, moments AND the frame count are all renormalized over the taps that PASSED.
        //
        // Normalizing the count matters more than it looks. An earlier version kept the
        // unnormalized weighted sum, reasoning that partial acceptance means partial history.
        // That is wrong, and it was THE reason the image never converged while the camera moved:
        // under sustained sub-pixel motion the accepted taps' bilinear weights almost never sum to
        // exactly 1, so the count follows n <- n*w + 1 and saturates at 1/(1-w) instead of growing
        // to the cap. At w = 0.9 that is 10 frames (32% of the raw noise left) and at w = 0.75 it
        // is 4 frames (50% left) -- permanently, no matter how long you keep moving. Standing still
        // makes w = 1 and the same code converges to the 48-frame cap, which is exactly the
        // "stable when still, noisy when walking" split.
        //
        // Weight loss from bilinear resampling is NOT evidence of missing history; it is evidence
        // of sub-pixel misalignment. Real disocclusion is handled by the geometry gate rejecting
        // taps outright, and by the count restarting when nothing survives at all.
        float inv = 1.0 / weightSum;
        histColor *= inv;
        histMoments *= inv;
        histFrames *= inv;
    } else {
        // ---- No history at all (disocclusion, or every tap failed the geometry gate).
        //
        // There is no clean reference to bound against here, so fall back to the spatial one. It is
        // much weaker (the neighbourhood is itself 1-spp noise, so its bound sits around 10x the
        // true level in shadow) but it still removes the extreme tail, and this branch covers a
        // small minority of pixels -- the common case in motion is a pixel that HAS history and is
        // handled by the far tighter temporal bound below.
        vec3 mean = vec3(0.0);
        vec3 meanSq = vec3(0.0);
        float count = 0.0;
        for (int dy = -FIREFLY_SPATIAL_RADIUS; dy <= FIREFLY_SPATIAL_RADIUS; dy++) {
            for (int dx = -FIREFLY_SPATIAL_RADIUS; dx <= FIREFLY_SPATIAL_RADIUS; dx++) {
                if (dx == 0 && dy == 0) {
                    continue; // exclude the centre: an outlier must not raise its own bound
                }
                vec3 c = loadCurrent(pix + ivec2(dx, dy));
                mean += c;
                meanSq += c * c;
                count += 1.0;
            }
        }
        mean /= count;
        meanSq /= count;
        vec3 sigma = sqrt(max(meanSq - mean * mean, vec3(0.0)));
        cur = min(cur, mean + FIREFLY_SPATIAL_SIGMA * sigma + vec3(FIREFLY_CLAMP_FLOOR));
        lum = dot(cur, LUMA);

        histColor = cur;
        histMoments = vec2(lum, lum * lum);
        histFrames = 0.0;
    }

    // ---- Sky: the tracer evaluates it analytically (sky gradient, sun disc, cloud coverage), so it
    // arrives noise-free. Accumulating it only adds reprojection resampling error and drags a
    // one-frame-stale sun across the screen while turning, so take it straight through and let the
    // à-trous pass skip it too. This is what keeps the sun a disc and cloud edges crisp.
    if (sky) {
        imageStore(histOut, pix, vec4(cur, 1.0));
        imageStore(momentsOut, pix, vec4(lum, lum * lum, min(histFrames + 1.0, max(pc.maxFrames, 1.0)), 0.0));
        imageStore(filterOut, pix, vec4(cur, 0.0));
        return;
    }

    // ---- Accumulate. 1/n up to the window cap converges the Monte-Carlo estimate as fast as an
    // unbiased running mean can, then holds a fixed exponential window so slow lighting changes are
    // still tracked. No motion-scaled alpha: motion is handled by REJECTING history that does not
    // reproject (above), not by discarding history that does.
    float frames = min(histFrames + 1.0, max(pc.maxFrames, 1.0));
    float alpha = 1.0 / frames;

    // ---- Firefly rejection, bounded by the HISTORY rather than by the neighbourhood.
    //
    // Why this and not a spatial clamp: a path-traced firefly occurs on every frame, yet the
    // artefact is only visible while the camera moves. That is the whole diagnosis. Standing still
    // the pixel has ~48 frames of history, so alpha is 0.02 and a spike contributes 2% -- invisible.
    // Moving, the frame count drops to 1-4, alpha is 0.25-1.0, and the same spike lands at up to
    // full strength. So the problem is not that fireflies exist, it is that motion removes the very
    // averaging that was hiding them.
    //
    // A neighbourhood clamp cannot fix that, because the neighbourhood is itself 1-spp noise: in
    // shadow its mean+4sigma bound sits around 10x the true level, so a firefly clamped to it is
    // still a visible ball. The accumulated history, in contrast, is an average of n samples with
    // 1/sqrt(n) the spread -- a bound of 2.9x the level at 4 frames, tightening to 1.5x at 48. It
    // is both far tighter and self-scaling: the more history a pixel has, the more confident the
    // rejection, and a pixel with no history keeps the neighbourhood fallback below.
    if (hasHistory) {
        float histLum = dot(histColor, LUMA);
        // Spread of the history itself, from the accumulated moments, floored so that a perfectly
        // converged pixel still tolerates a real lighting change.
        float histSigma = sqrt(max(histMoments.y - histMoments.x * histMoments.x, 0.0));
        float bound = histLum + FIREFLY_HISTORY_SIGMA * histSigma
                + FIREFLY_HISTORY_RELATIVE * histLum + FIREFLY_CLAMP_FLOOR;
        if (lum > bound) {
            // Scale the colour rather than clipping channels, so hue survives the rejection.
            cur *= bound / lum;
            lum = bound;
        }
    }

    vec3 accum = mix(histColor, cur, alpha);
    vec2 moments = mix(histMoments, vec2(lum, lum * lum), alpha);


    // ---- Variance for the spatial pass.
    //
    // The temporal estimate is the honest one, but it needs a few frames before it means anything.
    // The handover used to be a hard if/else at 4 frames, which put a visible seam wherever
    // neighbouring pixels straddled the threshold. It is now a linear blend over the same window,
    // so a pixel's guidance changes continuously as its history grows.
    float variance;
    float temporalVar = max(moments.y - moments.x * moments.x, 0.0);
    if (frames >= SPATIAL_VARIANCE_FRAMES) {
        variance = temporalVar;
    } else {
        // Too little history to measure anything (fresh disocclusion): estimate the noise level
        // spatially over a 7x7 window of THIS frame instead, so freshly revealed geometry is filtered
        // hard immediately instead of showing a frame or two of raw noise.
        float sum = 0.0;
        float sumSq = 0.0;
        float count = 0.0;
        for (int dy = -SPATIAL_VARIANCE_RADIUS; dy <= SPATIAL_VARIANCE_RADIUS; dy++) {
            for (int dx = -SPATIAL_VARIANCE_RADIUS; dx <= SPATIAL_VARIANCE_RADIUS; dx++) {
                float l = dot(loadCurrent(pix + ivec2(dx, dy)), LUMA);
                sum += l;
                sumSq += l * l;
                count += 1.0;
            }
        }
        float mean = sum / count;
        float spatial = max(sumSq / count - mean * mean, 0.0);
        // No history-dependent boost. Scaling by 4/frames made the edge-stop sigma jump by up to 2x
        // between neighbouring pixels purely because their history lengths differed, and jump again
        // frame to frame as those lengths changed -- a second source of the same mutating-filter
        // artefact as the reach cap. The spatial estimate is already the right magnitude for a
        // 1-spp signal; the smooth blend below is what carries the "trust me less" information.
        // Blend spatial -> temporal across the window rather than switching at a threshold.
        float t = clamp(frames / SPATIAL_VARIANCE_FRAMES, 0.0, 1.0);
        variance = mix(spatial, temporalVar, t);
    }

    // histOut is the fallback history for the next frame; the à-trous pass overwrites it with its
    // first iteration's (cleaner) result, which is why the frame count does not live in its alpha.
    imageStore(histOut, pix, vec4(accum, 1.0));
    imageStore(momentsOut, pix, vec4(moments, frames, 0.0));
    imageStore(filterOut, pix, vec4(accum, variance));
}
